server {
    # Railway injects PORT at runtime; defaults to 80 for Docker Compose.
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Same-network API proxy used by Docker Compose. The upstream is held in a
    # variable so nginx still starts when no "api" host exists (e.g. on Railway,
    # where the browser calls the API's own public URL via VITE_API_URL).
    location /api/ {
        resolver 127.0.0.11 valid=10s;
        set $backend "http://api:4000";
        proxy_pass $backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # SPA fallback — serve index.html for client-side routes.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
