# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://assetadmin:assetpass@localhost:5432/asset_platform?schema=public"

# JWT signing secret — generate a long random value in production
JWT_SECRET="change_me_in_production"
JWT_EXPIRES_IN="1d"

# API server
PORT=4000

# Allowed CORS origin for the web client
CLIENT_ORIGIN="http://localhost:5173"
